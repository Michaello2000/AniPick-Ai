# All configuration is server-only. Browsing and AniList imports need no AI key.
PORT=3001
ANIPICK_DB_PATH=./data/anipick.sqlite
# Register a MyAnimeList API application, then paste ONLY its client ID here.
# Required for MAL public lists because hosted Jikan no longer exposes them.
MAL_CLIENT_ID=
# AI recommendations: obtain a Gemini API key from https://aistudio.google.com/apikey
# Never use a VITE_ prefix or put this key into browser code.
GEMINI_API_KEY=
AI_PROVIDER=google
AI_MODEL=gemma-4-26b-a4b-it
