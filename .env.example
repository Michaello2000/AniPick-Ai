# All configuration is server-only. Browsing and AniList imports need no AI key.
PORT=3001
ANIPICK_DB_PATH=./data/anipick.sqlite
# Register a MyAnimeList API application, then paste ONLY its client ID here.
# Required for MAL public lists because hosted Jikan no longer exposes them.
MAL_CLIENT_ID=
# AI recommendations: obtain a Gemini API key from https://aistudio.google.com/apikey
# Never use a VITE_ prefix or put this key into browser code.
GEMINI_API_KEY=
AI_PROVIDER=google
AI_MODEL=gemma-4-26b-a4b-it
# Optional local inference. Keep Google settings above to switch back at any time.
# AI_PROVIDER=local makes local the default; the UI can choose either mode.
LOCAL_AI_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_AI_MODEL=
LOCAL_AI_RUNTIME=llamacpp
LOCAL_AI_TIMEOUT_MS=600000
LOCAL_AI_MAX_TOKENS=16384
# auto detects Bonsai 2 sizes from the served ID; override aliases with
# bonsai2-small (2B/4B/9B), bonsai2-27b, or generic.
LOCAL_AI_SAMPLING=auto
# Optional authentication required by your local server. Never sent to Google.
LOCAL_AI_API_KEY=
